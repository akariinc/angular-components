load(
    "//tools:defaults.bzl",
    "markdown_to_html",
    "ng_module",
    "ng_test_library",
    "ng_web_test_suite",
    "sass_library",
)

package(default_visibility = ["//visibility:public"])

ng_module(
    name = "custom-sanitizer",
    srcs = glob(
        ["**/*.ts"],
        exclude = [
            "**/*.spec.ts",
        ],
    ),
    deps = [
        "@npm//@angular/core",
        "@npm//@angular/platform-browser",
    ],
)

sass_library(
    name = "custom_sanitizer_scss_lib",
    srcs = glob(["**/_*.scss"]),
    deps = [
        "//src/material/core:core_scss_lib",
    ],
)

ng_test_library(
    name = "sanitizer_tests_lib",
    srcs = glob(
        ["**/*.spec.ts"],
    ),
    deps = [
        ":custom-sanitizer",
    ],
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [
        ":custom_sanitizer_tests_lib",
    ],
)

markdown_to_html(
    name = "overview",
    srcs = [":custom-sanitizer.md"],
)

filegroup(
    name = "source-files",
    srcs = glob(["**/*.ts"]),
)
